# ── Production Exclusion Manifest (.prodignore) ──────────────────────────────
# Files and directories listed here are excluded from the 'main' (production)
# branch while remaining 100% tracked and active in 'dev' and research branches.
# IMPORTANT: Always prefix with '/' to match root only and never exclude src/app/api!

# Non-production research datasets, offline tests, and study results
/scratch/
/learning/
/package/
/run_logs/
/temp_docx/
/indicators/
/graphify-out/
/.cache/
/.agents/
/.antigravitycli/
/.venv/
/__pycache__/

# AI Directives & Research Documentation (dev only)
/docs/
/directives/

# Compressed archives & temporary binary packages
*.rar
*.zip

# Pine script & legacy text analysis dumps
*.txt
*.pine

# Agent and IDE tool configurations (dev only)
.cursorrules
.graphifyignore
skills-lock.json
